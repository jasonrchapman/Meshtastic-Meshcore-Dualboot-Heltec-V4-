# Target
CONFIG_IDF_TARGET="esp32s3"

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# Partition table — use our custom CSV
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_dualboot.csv"

# OTA (needed for esp_ota_ops.h)
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n

# NVS
CONFIG_NVS_ENCRYPTION=n

# Reduce binary size (selector must fit comfortably in the 2MB factory partition)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# Console on UART, not USB (ESP32-S3): the dual-boot handoff bug traces to this
# peripheral - a USB console here shares hardware with whichever app
# (MeshCore/Meshtastic) boots next, and the host never sees a clean disconnect
# in between. UART keeps console output available for debugging without
# touching USB at all during the boot-selection window.
#
# IDF defaults to ALSO enabling a secondary console on the native
# USB_SERIAL_JTAG peripheral when UART is primary on this chip - that's the
# exact peripheral mode both MeshCore 1.17.1 and Meshtastic use
# (ARDUINO_USB_MODE=1), so leaving it on would defeat this fix. Disable it.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# NOTE: the GPIO-hold factory-reset feature (CONFIG_BOOTLOADER_FACTORY_RESET,
# "hold PRG for 3s") used to be here. Removed - confirmed by hand-testing
# that holding PRG through a reset always wins the race against the ROM's
# own download-mode strapping check on this board, so the bootloader's own
# long-hold detection never gets a chance to run. Replaced by the
# bootloader_components/factory_reset_hook/ reset-reason hook instead -
# see that file for the real, reliable mechanism: every hardware reset
# (RST button/power-on) now shows the selector automatically, no PRG
# involved at all.
